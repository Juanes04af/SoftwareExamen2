<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!-- Vista principal. Adaptador de entrada: ControlExamen. Autor: Juan Rosero -->
<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="co.edu.poli.examen2.infraestructura.ui.ControlExamen"
      styleClass="panel" alignment="CENTER" spacing="14.0" stylesheets="@styles.css">

   <padding>
      <Insets bottom="24.0" left="30.0" right="30.0" top="24.0" />
   </padding>

   <Label text="Registro de Examen" styleClass="titulo" />
   <Separator />

   <GridPane hgap="12.0" vgap="12.0">
      <Label text="Código del Examen:" styleClass="etiqueta" GridPane.columnIndex="0" GridPane.rowIndex="0" />
      <TextField fx:id="txtCodigoExamen" promptText="Ej: EXM-001" prefWidth="300.0"
                 GridPane.columnIndex="1" GridPane.rowIndex="0" />

      <Label text="Nombre del Paciente:" styleClass="etiqueta" GridPane.columnIndex="0" GridPane.rowIndex="1" />
      <TextField fx:id="txtNombrePaciente" promptText="Ingrese el nombre completo" prefWidth="300.0"
                 GridPane.columnIndex="1" GridPane.rowIndex="1" />

      <Label text="Costo ($):" styleClass="etiqueta" GridPane.columnIndex="0" GridPane.rowIndex="2" />
      <TextField fx:id="txtCosto" promptText="Ej: 150.00" prefWidth="300.0"
                 GridPane.columnIndex="1" GridPane.rowIndex="2" />

      <Label text="Tipo de Sangre:" styleClass="etiqueta" GridPane.columnIndex="0" GridPane.rowIndex="3" />
      <ComboBox fx:id="cmbTipoSangre" promptText="Seleccione..." prefWidth="300.0"
                GridPane.columnIndex="1" GridPane.rowIndex="3" />

      <Label text="Factor RH:" styleClass="etiqueta" GridPane.columnIndex="0" GridPane.rowIndex="4" />
      <HBox spacing="20.0" alignment="CENTER_LEFT" GridPane.columnIndex="1" GridPane.rowIndex="4">
         <RadioButton fx:id="rbPositivo" text="Positivo (Rh+)" selected="true">
            <toggleGroup>
               <ToggleGroup fx:id="tgFactorRH" />
            </toggleGroup>
         </RadioButton>
         <RadioButton fx:id="rbNegativo" text="Negativo (Rh−)" toggleGroup="$tgFactorRH" />
      </HBox>

      <Label text="Formato de archivo:" styleClass="etiqueta" GridPane.columnIndex="0" GridPane.rowIndex="5" />
      <ComboBox fx:id="cmbFormato" prefWidth="300.0" GridPane.columnIndex="1" GridPane.rowIndex="5" />
   </GridPane>

   <Separator />

   <HBox spacing="12.0" alignment="CENTER">
      <Button text="Guardar" onAction="#handleGuardar" styleClass="boton, boton-guardar" />
      <Button text="Listar" onAction="#handleListar" styleClass="boton, boton-listar" />
      <Button text="Limpiar" onAction="#handleLimpiar" styleClass="boton, boton-limpiar" />
   </HBox>
   <HBox spacing="12.0" alignment="CENTER">
      <Button text="Serializar" onAction="#handleSerializar" styleClass="boton, boton-serializar" />
      <Button text="Deserializar" onAction="#handleDeserializar" styleClass="boton, boton-deserializar" />
   </HBox>

   <Separator />

   <Label text="Mensajes:" styleClass="etiqueta" />
   <TextArea fx:id="txtAreaMensajes" promptText="Los mensajes se mostrarán aquí..."
             prefHeight="170.0" prefWidth="460.0" editable="false" wrapText="true" styleClass="mensajes" />
</VBox>
